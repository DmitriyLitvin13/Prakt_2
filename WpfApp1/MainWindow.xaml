<Window x:Class="Prakt2_Var7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Практическая 2 Вар 7" Height="450" Width="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Сохранить" Click="Save_Click"/>
                <MenuItem Header="Открыть" Click="Open_Click"/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Действия">
                <MenuItem Header="Заполнить" Click="Fill_Click"/>
                <MenuItem Header="Очистить" Click="Clear_Click"/>
                <MenuItem Header="Рассчитать" Click="Calculate_Click"/>
            </MenuItem>
        </Menu>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <TextBlock Text="M=" VerticalAlignment="Center"/>
            <TextBox x:Name="textRow" Width="40" Text="3"/>
            <TextBlock Text=" N=" VerticalAlignment="Center" Margin="5,0,0,0"/>
            <TextBox x:Name="textCol" Width="40" Text="4"/>
            <Button Content="Заполнить" Margin="10,0,0,0" Padding="5,2" Click="Fill_Click"/>
            <Button Content="Рассчитать" Margin="5,0,0,0" Padding="5,2" Click="Calculate_Click"/>
            <Button Content="О программе" Margin="5,0,0,0" Padding="5,2" Click="About_Click"/>
            <Button Content="Выход" Margin="5,0,0,0" Padding="5,2" Click="Exit_Click"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="dataGridMatrix" Margin="5" CanUserAddRows="False"/>
            <DataGrid x:Name="dataGridResult" Grid.Column="1" Margin="5" CanUserAddRows="False"/>
        </Grid>
    </Grid>
</Window>